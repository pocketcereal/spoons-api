# Database
DATABASE_URL=postgres://spoons:spoons@localhost:5432/spoons

# PodcastIndex API (get keys from https://api.podcastindex.org/)
PODCAST_INDEX_API_KEY=your_api_key_here
PODCAST_INDEX_API_SECRET=your_api_secret_here

# Optional: Supabase auth
SPOONS_SUPABASE_URL=
SPOONS_JWT_SECRET=
SPOONS_DEV_TOKEN=

# Optional: Disable authentication for local development
SPOONS_AUTH_DISABLED=true
